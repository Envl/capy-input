    "onboardingClipboardRequestHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap below once so iOS shows the Paste from Other Apps option in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点下方按钮触发一次读取，使系统设置中出现“从其他 App 粘贴”选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點下方按鈕觸發一次讀取，使系統設定中出現「從其他 App 貼上」選項。"
          }
        }
