    "onboardingEnableKeyboardHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Little Capybara in Settings → Keyboards. Allow Full Access to use sync, clipboard, or voice input from the keyboard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统“设置 → 键盘”中添加小水豚。如需在键盘中使用同步、剪贴板或语音输入，请开启“允许完全访问”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統「設定 → 鍵盤」中加入小水豚。如需在鍵盤中使用同步、剪貼簿或語音輸入，請開啟「允許完全取用」。"
          }
        }
      }
    },
