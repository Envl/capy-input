    "onboardingClipboardDisabledHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard history is off. The clipboard button and idle paste suggestions will be hidden from the keyboard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板功能已关闭。键盘上的剪贴板按钮与快捷粘贴建议将会隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼簿功能已關閉。鍵盤上的剪貼簿按鈕與快速貼上建議將會隱藏。"
          }
        }
      }
    },
    "onboardingClipboardEnabledHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show recent copies and one-tap paste suggestions on the keyboard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在键盘上显示剪贴板历史与一键粘贴建议。"
