    },
    "onboardingClipboardSettingsHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set Paste from Other Apps to Allow so the keyboard can read copies without asking every time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将“从其他 App 粘贴”设为“允许”，避免每次粘贴时反复弹窗确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將「從其他 App 貼上」設為「允許」，避免每次貼上時反覆彈窗確認。"
          }
        }
      }
    },
