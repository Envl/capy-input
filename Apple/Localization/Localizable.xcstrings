        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在鍵盤上顯示剪貼簿歷史與一鍵貼上建議。"
          }
        }
      }
    },
    "onboardingClipboardPermissionRequested": {
