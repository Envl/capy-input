    "membershipCloudDisclosure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CapyInput sends your dictation audio to its server and to Soniox or OpenAI for transcription."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小水豚输入法会将语音音频发送到服务器，并由 Soniox 或 OpenAI 转写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小水豚輸入法會將語音音訊傳送到伺服器，並由 Soniox 或 OpenAI 轉錄。"
          }
        }
      }
    },
    "membershipConsentRequired": {
      "extractionState": "manual",
